<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;700;900&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="{{ '/assets/css/style.css' | url }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/favicon-32x32.png' | url }}">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ '/assets/favicon-16x16.png' | url }}">
  <link rel="icon" type="image/x-icon" href="{{ '/assets/favicon.ico' | url }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/apple-touch-icon.png' | url }}">

  <title>{{ title }}</title>
  <meta name="description" content="{{ description or 'Les jambes qui doutent - Compagnie de danse' }}">
  <meta name="keywords" content="{{ keywords or 'danse, théâtre, compagnie, performance, Île-de-France' }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or 'Les jambes qui doutent - Compagnie de danse' }}">
  <meta property="og:type" content="website">
</head>

<body>

{% include "../components/header.njk" %}

<main>
  <div class="home-container">
    {{ content | safe }}
  </div>
</main>

{% include "../components/footer.njk" %}

</body>
</html>