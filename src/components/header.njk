<header class="site-header" data-mobile-header>
	{% from "./button.njk" import navButton, ctaButton %}

	<a href="/" class="site-header__brand" aria-label="Retour à l'accueil">
		<img src="/assets/images/ljqd.jpg" alt="Logo du site" class="site-header__logo">
		<span class="site-header__wordmark" aria-hidden="true"></span>
	</a>

	<button
		type="button"
		class="site-header__menu-toggle"
		aria-expanded="false"
		aria-controls="site-header-nav"
		aria-label="Ouvrir le menu"
	>
		<span class="site-header__menu-toggle-line" aria-hidden="true"></span>
		<span class="site-header__menu-toggle-line" aria-hidden="true"></span>
		<span class="site-header__menu-toggle-line" aria-hidden="true"></span>
	</button>

	<nav id="site-header-nav" class="site-header__nav" aria-label="Navigation principale">
		{{ navButton('/' | url, 'Accueil', page.url == '/') }}
		<div class="site-header__dropdown" data-dropdown>
			<button
				type="button"
				class="site-header__nav-button site-header__dropdown-toggle{% if page.url == '/longue-distance/' or page.url == '/la-nuit-noire/' %} site-header__nav-button--active{% endif %}"
				aria-expanded="false"
				aria-controls="spectacles-submenu"
			>
				Spectacles
			</button>
			<div id="spectacles-submenu" class="site-header__submenu" role="menu" aria-label="Sous-menu spectacles">
				<a href="{{ '/longue-distance/' | url }}" class="site-header__submenu-link{% if page.url == '/longue-distance/' %} site-header__submenu-link--active{% endif %}" role="menuitem">Longue distance</a>
				<a href="{{ '/la-nuit-noire/' | url }}" class="site-header__submenu-link{% if page.url == '/la-nuit-noire/' %} site-header__submenu-link--active{% endif %}" role="menuitem">La nuit noire</a>
			</div>
		</div>
		{{ navButton('/agenda/' | url, 'Agenda', page.url.startsWith('/agenda')) }}
		{{ navButton('/artists/' | url, 'Les artistes', page.url.startsWith('/artists')) }}
		{{ navButton('/support/' | url, 'Nous soutenir', page.url.startsWith('/support')) }}
		{{ ctaButton('/contact/' | url, 'Nous contacter', page.url.startsWith('/contact')) }}
	</nav>
</header>

<script>
	(function () {
		var header = document.querySelector('[data-mobile-header]');
		if (!header) {
			return;
		}

		var toggle = header.querySelector('.site-header__menu-toggle');
		var nav = header.querySelector('.site-header__nav');
		var dropdown = header.querySelector('[data-dropdown]');
		var dropdownToggle = dropdown ? dropdown.querySelector('.site-header__dropdown-toggle') : null;
		if (!toggle || !nav) {
			return;
		}

		function setExpanded(expanded) {
			header.classList.toggle('is-open', expanded);
			toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
			toggle.setAttribute('aria-label', expanded ? 'Fermer le menu' : 'Ouvrir le menu');
		}

		function setSubmenuExpanded(expanded) {
			if (!dropdown || !dropdownToggle) {
				return;
			}

			dropdown.classList.toggle('is-expanded', expanded);
			dropdownToggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
		}

		toggle.addEventListener('click', function () {
			setExpanded(!header.classList.contains('is-open'));
			if (window.innerWidth > 720) {
				setSubmenuExpanded(false);
			}
		});

		if (dropdownToggle) {
			dropdownToggle.addEventListener('click', function (event) {
				if (window.innerWidth > 720) {
					return;
				}

				event.preventDefault();
				setSubmenuExpanded(!dropdown.classList.contains('is-expanded'));
			});
		}

		nav.addEventListener('click', function (event) {
			var isDropdownToggle = event.target.closest('.site-header__dropdown-toggle');
			var isNavigationTarget = event.target.closest('.site-header__nav-button, .site-header__cta-button, .site-header__submenu-link');

			if (window.innerWidth <= 720 && isNavigationTarget && !isDropdownToggle) {
				setExpanded(false);
				setSubmenuExpanded(false);
			}
		});

		document.addEventListener('click', function (event) {
			if (!dropdown || window.innerWidth <= 720) {
				return;
			}

			if (!dropdown.contains(event.target)) {
				setSubmenuExpanded(false);
			}
		});

		document.addEventListener('keydown', function (event) {
			if (event.key === 'Escape') {
				setSubmenuExpanded(false);
			}
		});

		window.addEventListener('resize', function () {
			if (window.innerWidth > 960) {
				setExpanded(false);
			}

			if (window.innerWidth > 720) {
				setSubmenuExpanded(false);
			}
		});
	})();
</script>
